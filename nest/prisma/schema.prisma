// Prisma schema for Susi Air Pilot App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // In production, this should be hashed
  name      String
  avatar    String?
  email     String   @unique
  role      String   @default("pilot")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flightHours FlightHours[]
  documents   Document[]
  schedules   Schedule[]
  sessions    Session[]

  @@index([username])
  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastActivity DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model FlightHours {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  hours     Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([userId, date])
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String
  expiryDate DateTime @db.Date
  thresholdDays Int     @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiryDate])
}

model Schedule {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  dutyType        String
  baseColor       String
  countSchedules  Int      @default(1)
  countLogbooks   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, date])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  identifier String  // IP + username combination
  count     Int      @default(1)
  lastAttempt DateTime @default(now())
  lockedUntil DateTime?
  @@unique([identifier])
  @@index([identifier])
}
